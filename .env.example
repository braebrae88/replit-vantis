# ============================================
# FORGE VANTIS Mission Control - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# DATABASE CONFIGURATION (Required)
# ============================================
# PostgreSQL connection URL (provided by Replit or your hosting provider)
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: Individual PostgreSQL connection parameters
# These are typically derived from DATABASE_URL automatically
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=mission_control

# ============================================
# AI COMPANION CONFIGURATION (Future)
# ============================================
# Google AI Studio API Key for AI Companion integration
# Get your key at: https://aistudio.google.com/apikey
# GOOGLE_AI_API_KEY=your_google_ai_api_key

# OpenAI API Key (alternative AI provider)
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key

# ============================================
# FUTURE INTEGRATIONS
# ============================================
# Microsoft Graph API for Outlook/Calendar integration
# Register an app at: https://portal.azure.com
# MS_GRAPH_CLIENT_ID=your_client_id
# MS_GRAPH_CLIENT_SECRET=your_client_secret
# MS_GRAPH_TENANT_ID=your_tenant_id

# File System Watcher Configuration (macOS)
# Path to watch for file events
# FILE_WATCH_PATH=/path/to/watched/directory

# ============================================
# SERVER CONFIGURATION
# ============================================
# Port for the server (defaults to 5000)
# PORT=5000

# Node environment (development, production)
# NODE_ENV=development
